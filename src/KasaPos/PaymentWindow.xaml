<Window x:Class="KasaPos.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ödeme" Width="720" Height="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="Segoe UI" Background="{StaticResource PanelBg}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Tutar" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtAmount" FontSize="26" FontWeight="Bold" Height="52"/>
                <UniformGrid Columns="4" Margin="0,4">
                    <Button Content="Kalan" Click="Exact_Click"/>
                    <Button Content="100" Click="Quick_Click"/>
                    <Button Content="200" Click="Quick_Click"/>
                    <Button Content="500" Click="Quick_Click"/>
                </UniformGrid>
                <TextBlock Text="Ödeme türünü seç (tutar o türle eklenir)" Style="{StaticResource Label}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="PnlTypes"/>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="12,0,0,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Toplam" Style="{StaticResource Label}"/>
                <TextBlock x:Name="TxtTotal" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Kalan" Style="{StaticResource Label}"/>
                <TextBlock x:Name="TxtRemaining" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="TxtChange" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ok}" Margin="0,6,0,0"/>
                <TextBlock Text="Alınan ödemeler" Style="{StaticResource Label}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <CheckBox x:Name="ChkPrint" Content="Fiş yazdır"/>
                <Button Content="Seçili ödemeyi sil" Style="{StaticResource DangerButton}" Click="RemovePay_Click"/>
                <UniformGrid Columns="2">
                    <Button Content="Vazgeç" IsCancel="True"/>
                    <Button x:Name="BtnDone" Content="Tamamla" Style="{StaticResource OkButton}" Click="Done_Click" IsEnabled="False" MinHeight="54" FontSize="18"/>
                </UniformGrid>
            </StackPanel>
            <ListBox x:Name="LstPayments" FontSize="16" DisplayMemberPath="Display" Margin="3"/>
        </DockPanel>
    </Grid>
</Window>
