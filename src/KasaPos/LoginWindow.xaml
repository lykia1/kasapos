<Window x:Class="KasaPos.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giriş" Width="380" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" FontFamily="Segoe UI" Background="{StaticResource Dark}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtBiz" Foreground="White" FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtApp" Foreground="#9AA5B1" FontSize="13" TextAlignment="Center" Margin="0,2,0,14"/>
        <PasswordBox x:Name="TxtPin" FontSize="28" HorizontalContentAlignment="Center" Height="54" MaxLength="10"/>
        <TextBlock x:Name="TxtError" Foreground="#FF8787" TextAlignment="Center" Margin="0,6,0,0" FontSize="14"/>
        <UniformGrid x:Name="Pad" Columns="3" Margin="0,8,0,0">
            <Button Content="1" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="2" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="3" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="4" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="5" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="6" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="7" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="8" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="9" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="Sil" Click="Clear_Click" FontSize="18" Height="64"/>
            <Button Content="0" Click="Digit_Click" FontSize="24" Height="64"/>
            <Button Content="Giriş" Click="Login_Click" FontSize="18" Height="64" Style="{StaticResource AccentButton}"/>
        </UniformGrid>
        <Button Content="Programdan Çık" Click="Exit_Click" Margin="3,12,3,0" MinHeight="36" FontSize="13"
                Background="Transparent" Foreground="#9AA5B1" BorderBrush="#52606D"/>
    </StackPanel>
</Window>
