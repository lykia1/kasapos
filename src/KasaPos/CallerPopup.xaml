<Window x:Class="KasaPos.CallerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gelen Arama" Width="420" SizeToContent="Height" Topmost="True" ShowActivated="True"
        WindowStyle="ToolWindow" ResizeMode="NoResize" FontFamily="Segoe UI" Background="White">
    <StackPanel>
        <Border Background="#1971C2" Padding="16,12">
            <StackPanel>
                <TextBlock Text="📞  GELEN ARAMA" Foreground="White" FontSize="14" FontWeight="SemiBold" Opacity="0.9"/>
                <TextBlock x:Name="TxtPhone" Foreground="White" FontSize="28" FontWeight="Bold"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="16,10">
            <TextBlock x:Name="TxtName" FontSize="20" FontWeight="Bold" Foreground="#212529" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtAddress" FontSize="15" Foreground="#495057" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtHistory" FontSize="13" Foreground="#868E96" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <UniformGrid Columns="2" Margin="10,0,10,12">
            <Button Content="Kapat" Click="Close_Click"/>
            <Button Content="Paket Sipariş Aç" Style="{StaticResource AccentButton}" Click="Open_Click" MinHeight="52" FontSize="16"/>
        </UniformGrid>
    </StackPanel>
</Window>
