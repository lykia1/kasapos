<Window x:Class="KasaPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KasaPOS" Height="768" Width="1280" MinWidth="1024" MinHeight="680"
        WindowState="Maximized" Icon="/app.ico" FontFamily="Segoe UI" Background="#E9EDF2"
        Closed="Window_Closed">
    <Window.Resources>
        <!-- Ana ekran kutucuğu (renk Ayarlar'dan) -->
        <SolidColorBrush x:Key="TileBrush" Color="#E8590C"/>
        <Style x:Key="HomeTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource TileBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <!-- Alt işlem çubuğu düğmesi -->
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Üst bar -->
        <Border DockPanel.Dock="Top" Background="#1E2A3A" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnLicense" Style="{StaticResource FlatButton}" Foreground="#FFD43B" FontSize="13" MinHeight="32" Click="BtnLicense_Click"/>
                    <TextBlock x:Name="TxtUser" Foreground="#C5CFDB" FontSize="14" Margin="12,0" VerticalAlignment="Center"/>
                    <Button Content="Kilitle" Style="{StaticResource TopButton}" Click="BtnLock_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnHome" Content="◄  Ana Ekran" Style="{StaticResource TopButton}" Click="BtnHome_Click" Background="#F76707" BorderBrush="#F76707"/>
                    <Border Background="#F76707" CornerRadius="8" Width="34" Height="34" Margin="12,0,10,0">
                        <TextBlock x:Name="TxtLogo" Foreground="White" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtBiz" Foreground="White" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDay" Foreground="#C5CFDB" FontSize="14" Margin="22,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtClock" Foreground="White" FontSize="18" FontWeight="Bold" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- ================= ANA EKRAN ================= -->
            <Grid x:Name="ViewHome" Margin="8" Background="#EEF1F4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2.3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Style="{StaticResource HomeTile}" Click="HomeMasa_Click" Grid.Row="0" Grid.Column="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Masalar" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="HomePaket_Click" Grid.Row="0" Grid.Column="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Paket Servis" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="HomeGelAl_Click" Grid.Row="0" Grid.Column="2">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gel Al" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="BtnKds_Click" Grid.Row="0" Grid.Column="3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mutfak Ekranı" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="BtnCustomers_Click" Grid.Row="0" Grid.Column="4">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Müşteriler" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="BtnExpenses_Click" Grid.Row="0" Grid.Column="5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Giderler" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="BtnCash_Click" Grid.Row="1" Grid.Column="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kasa" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="BtnStaff_Click" Grid.Row="2" Grid.Column="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Personel" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnReports" Style="{StaticResource HomeTile}" Click="BtnReports_Click" Grid.Row="3" Grid.Column="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Raporlar" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnStock" Style="{StaticResource HomeTile}" Click="BtnStock_Click" Grid.Row="3" Grid.Column="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Stok" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnDayEnd" Style="{StaticResource HomeTile}" Click="BtnDayEnd_Click" Grid.Row="3" Grid.Column="2">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gün Sonu" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSettings" Style="{StaticResource HomeTile}" Click="BtnSettings_Click" Grid.Row="3" Grid.Column="3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ayarlar" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="BtnLock_Click" Grid.Row="3" Grid.Column="4">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kilitle" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HomeTile}" Click="BtnExit_Click" Grid.Row="3" Grid.Column="5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="Çıkış" FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Orta panel: günün özeti ve açık siparişler -->
                <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Grid.ColumnSpan="5" Background="White" CornerRadius="10" Margin="5" Padding="14,10">
                    <DockPanel>
                        <UniformGrid DockPanel.Dock="Top" Columns="5">
                            <StackPanel Margin="4">
                                <TextBlock Text="Bugünkü ciro" Foreground="#868E96" FontSize="13"/>
                                <TextBlock x:Name="TxtStatSales" FontSize="24" FontWeight="Bold" Foreground="#2F9E44"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Satış sayısı" Foreground="#868E96" FontSize="13"/>
                                <TextBlock x:Name="TxtStatCount" FontSize="24" FontWeight="Bold" Foreground="#1971C2"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Açık masa" Foreground="#868E96" FontSize="13"/>
                                <TextBlock x:Name="TxtStatTables" FontSize="24" FontWeight="Bold" Foreground="#E8590C"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Yoldaki paket" Foreground="#868E96" FontSize="13"/>
                                <TextBlock x:Name="TxtStatPaket" FontSize="24" FontWeight="Bold" Foreground="#7048E8"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Kritik stok" Foreground="#868E96" FontSize="13"/>
                                <TextBlock x:Name="TxtStatStock" FontSize="24" FontWeight="Bold" Foreground="#E03131"/>
                            </StackPanel>
                        </UniformGrid>
                        <Border DockPanel.Dock="Top" Height="1" Background="#E9ECEF" Margin="0,8"/>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                            <TextBlock x:Name="TxtOpenCount" DockPanel.Dock="Right" Foreground="#868E96" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Açık Siparişler" FontWeight="Bold" FontSize="16" Foreground="#212529"/>
                        </DockPanel>
                        <ListBox x:Name="LstOpen" SelectionChanged="LstOpen_SelectionChanged" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="190" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="4,1,1,1" CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" Foreground="#212529"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Sağ üst: işletme kutusu -->
                <Border Grid.Row="0" Grid.Column="6" Background="White" CornerRadius="10" Margin="5" Padding="14,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Background="{DynamicResource TileBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,14,0">
                            <TextBlock x:Name="TxtHomeLogo" Foreground="White" FontWeight="Bold" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHomeBiz" FontSize="22" FontWeight="Bold" Foreground="#212529" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtHomeDate" FontSize="14" Foreground="#868E96"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Sağ: gelen aramalar -->
                <Border Grid.Row="1" Grid.Column="6" Grid.RowSpan="3" Background="White" CornerRadius="10" Margin="5" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Son Aramalar" FontWeight="Bold" FontSize="16" Foreground="#212529" Margin="4,0,4,8"/>
                        <StackPanel x:Name="PnlCalls"/>
                    </DockPanel>
                </Border>
            </Grid>
            <!-- ================= SATIŞ EKRANI ================= -->
            <Grid x:Name="ViewSale" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>

                <!-- SOL: Adisyon -->
                <Border Grid.Column="0" Background="White" BorderBrush="#CED4DA" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Adisyon başlığı -->
                        <Border x:Name="BdType" DockPanel.Dock="Top" Background="#2F9E44" Padding="12,8">
                            <DockPanel>
                                <TextBlock x:Name="TxtTypeBadge" DockPanel.Dock="Right" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.9"/>
                                <TextBlock x:Name="TxtOrderTitle" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="TxtOrderNote" DockPanel.Dock="Top" FontSize="13" Foreground="#C92A2A" TextWrapping="Wrap" Margin="10,4,10,0"/>

                        <!-- Alt: toplam + ödeme -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="#1E2A3A" Padding="12,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Ara Toplam" FontSize="13" Foreground="#C5CFDB"/>
                                        <TextBlock x:Name="TxtSubtotal" FontSize="13" HorizontalAlignment="Right" Foreground="#C5CFDB"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="İndirim" FontSize="13" Foreground="#C5CFDB"/>
                                        <TextBlock x:Name="TxtDiscount" FontSize="13" HorizontalAlignment="Right" Foreground="#C5CFDB"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock Text="TOPLAM" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTotal" FontSize="34" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#FFD43B"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="4" Margin="2,2,2,0">
                                <Button Content="+1" Style="{StaticResource BarButton}" Background="#495057" Click="BtnPlus_Click" FontSize="18"/>
                                <Button Content="−1" Style="{StaticResource BarButton}" Background="#495057" Click="BtnMinus_Click" FontSize="18"/>
                                <Button Content="Adet" Style="{StaticResource BarButton}" Background="#495057" Click="BtnQty_Click"/>
                                <Button Content="Sil" Style="{StaticResource BarButton}" Background="#C92A2A" Click="BtnRemove_Click"/>
                                <Button Content="Ürün Notu" Style="{StaticResource BarButton}" Background="#5C7CFA" Click="BtnItemNote_Click"/>
                                <Button Content="Sip. Notu" Style="{StaticResource BarButton}" Background="#5C7CFA" Click="BtnOrderNote_Click"/>
                                <Button Content="İndirim" Style="{StaticResource BarButton}" Background="#5C7CFA" Click="BtnDiscount_Click"/>
                                <Button Content="Hesap Böl" x:Name="BtnSplit" Style="{StaticResource BarButton}" Background="#5C7CFA" Click="BtnSplit_Click"/>
                                <Button Content="Masa Taşı" x:Name="BtnMoveTable" Style="{StaticResource BarButton}" Background="#0C8599" Click="BtnMoveTable_Click"/>
                                <Button Content="Birleştir" x:Name="BtnMerge" Style="{StaticResource BarButton}" Background="#0C8599" Click="BtnMerge_Click"/>
                                <Button Content="Kurye" x:Name="BtnCourier" Style="{StaticResource BarButton}" Background="#7048E8" Click="BtnCourier_Click"/>
                                <Button Content="Adisyon" Style="{StaticResource BarButton}" Background="#868E96" Click="BtnPrintBill_Click"/>
                                <Button Content="İptal" Style="{StaticResource BarButton}" Background="#E03131" Click="BtnCancel_Click"/>
                                <Button Content="Kaydet" Style="{StaticResource BarButton}" Background="#F59F00" Click="BtnSave_Click" Grid.ColumnSpan="1"/>
                                <Button Content="Diğer Ödeme" Style="{StaticResource BarButton}" Background="#2B8A3E" Click="BtnPay_Click"/>
                                <Button Content="" Style="{StaticResource BarButton}" Background="Transparent" IsEnabled="False"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="2">
                                <Button Content="NAKİT" Style="{StaticResource BarButton}" Background="#2F9E44" FontSize="24" MinHeight="66" Click="BtnPayCash_Click"/>
                                <Button Content="KART" Style="{StaticResource BarButton}" Background="#1971C2" FontSize="24" MinHeight="66" Click="BtnPayCard_Click"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Paket müşteri bilgisi -->
                        <Border x:Name="PnlPaket" DockPanel.Dock="Top" Background="#E7F5FF" Padding="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TxtPhone" KeyDown="TxtPhone_KeyDown" ToolTip="Telefon"/>
                                <Button Grid.Column="1" Content="Bul" Click="BtnFindCustomer_Click" MinHeight="36"/>
                                <TextBox x:Name="TxtCustName" Grid.Row="1" Grid.ColumnSpan="2" ToolTip="Müşteri adı"/>
                                <TextBox x:Name="TxtCustAddress" Grid.Row="2" Grid.ColumnSpan="2" ToolTip="Adres" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- Kalemler -->
                        <Grid>
                            <TextBlock x:Name="TxtEmptyCart" Text="Adisyon boş&#x0a;Ürün eklemek için sağdaki ürünlere dokun"
                                       TextAlignment="Center" Foreground="#868E96" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ListBox x:Name="LstCart" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding QtyText}" FontWeight="Bold" Foreground="#E8590C" FontSize="17"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="16" Foreground="#212529" Margin="2,0,6,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="16" FontWeight="SemiBold" Foreground="#212529"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ORTA: ürünler / masa planı -->
                <DockPanel Grid.Column="1" Margin="8">
                    <DockPanel DockPanel.Dock="Top">
                        <Button x:Name="BtnTablePlan" DockPanel.Dock="Right" Content="▦  Masa Planı" Click="BtnTablePlan_Click" Visibility="Collapsed"
                                Background="#2F9E44" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbMasa" Content="Masa" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                            <RadioButton x:Name="RbPaket" Content="Paket" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                            <RadioButton x:Name="RbGelAl" Content="Gel Al" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,6,0,0">
                        <DockPanel x:Name="ViewMenu">
                            <Border DockPanel.Dock="Top" Background="White" CornerRadius="10" BorderBrush="#CED4DA" BorderThickness="1" Padding="4" Margin="3,0,3,6">
                                <DockPanel>
                                    <TextBlock Text="🔍" FontSize="15" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                    <Button x:Name="BtnClearSearch" DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatButton}"
                                            MinHeight="30" Padding="10,2" Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                                    <TextBox x:Name="TxtSearch" BorderThickness="0" TextChanged="TxtSearch_TextChanged" Margin="0" Background="Transparent"/>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="PnlProducts"/>
                            </ScrollViewer>
                        </DockPanel>

                        <DockPanel x:Name="ViewTables" Visibility="Collapsed">
                            <DockPanel DockPanel.Dock="Top">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#2F9E44"/>
                                    <TextBlock Text="Boş" Margin="5,0,14,0" Foreground="#495057"/>
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#E8590C"/>
                                    <TextBlock Text="Dolu" Margin="5,0,6,0" Foreground="#495057"/>
                                </StackPanel>
                                <WrapPanel x:Name="PnlAreas"/>
                            </DockPanel>
                            <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="10" Padding="8" Margin="3,6,3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Listede olmayan masa:" VerticalAlignment="Center" Foreground="#495057" Margin="4,0"/>
                                    <TextBox x:Name="TxtTable" Width="120" KeyDown="TxtTable_KeyDown"/>
                                    <Button Content="Aç" Click="BtnOpenManualTable_Click" MinHeight="36"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <WrapPanel x:Name="PnlTables"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>

                <!-- SAĞ: kategoriler -->
                <Border Grid.Column="2" Background="#1E2A3A">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PnlCategories" Margin="6"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
