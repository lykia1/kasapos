<Window x:Class="KasaPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KasaPOS" Height="768" Width="1280" MinWidth="1024" MinHeight="680"
        WindowState="Maximized" FontFamily="Segoe UI" Background="{StaticResource PanelBg}"
        Closed="Window_Closed">
    <DockPanel>
        <!-- Üst bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Dark}" Padding="12,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnMenu" Content="Menü" Style="{StaticResource TopButton}" Click="BtnMenu_Click"/>
                    <Button x:Name="BtnTables" Content="Masa Düzeni" Style="{StaticResource TopButton}" Click="BtnTables_Click"/>
                    <Button Content="Mutfak Ekranı" Style="{StaticResource TopButton}" Click="BtnKds_Click"/>
                    <Button x:Name="BtnCustomers" Content="Müşteriler" Style="{StaticResource TopButton}" Click="BtnCustomers_Click"/>
                    <Button x:Name="BtnExpenses" Content="Giderler" Style="{StaticResource TopButton}" Click="BtnExpenses_Click"/>
                    <Button x:Name="BtnReports" Content="Raporlar" Style="{StaticResource TopButton}" Click="BtnReports_Click"/>
                    <Button x:Name="BtnSettings" Content="Ayarlar" Style="{StaticResource TopButton}" Click="BtnSettings_Click"/>
                    <Button Content="Kilitle" Style="{StaticResource TopButton}" Click="BtnLock_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Accent}" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtLogo" Foreground="White" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtBiz" Foreground="White" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtUser" Foreground="#ADB5BD" FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDay" Foreground="#ADB5BD" FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtClock" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: açık siparişler -->
            <DockPanel Grid.Column="0" Margin="10,10,4,10">
                <Button DockPanel.Dock="Top" Content="+  Yeni Sipariş" Style="{StaticResource AccentButton}" Click="BtnNew_Click" MinHeight="52" FontSize="16"/>
                <DockPanel DockPanel.Dock="Top" Margin="4,12,4,6">
                    <TextBlock x:Name="TxtOpenCount" DockPanel.Dock="Right" Foreground="{StaticResource TextSub}" FontSize="13"/>
                    <TextBlock Text="Açık Siparişler" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextMain}"/>
                </DockPanel>
                <ListBox x:Name="LstOpen" SelectionChanged="LstOpen_SelectionChanged" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="10,8">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextMain}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Orta -->
            <DockPanel Grid.Column="1" Margin="6,10,6,10">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button x:Name="BtnTablePlan" DockPanel.Dock="Right" Content="Masa Planı" Click="BtnTablePlan_Click" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbGelAl" Content="Al Götür" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                            <RadioButton x:Name="RbMasa" Content="Masa" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                            <RadioButton x:Name="RbPaket" Content="Paket" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="PnlPaket" Style="{StaticResource Card}" Visibility="Collapsed" Margin="3,6,3,0" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Telefon" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBox x:Name="TxtPhone" Grid.Column="1" KeyDown="TxtPhone_KeyDown"/>
                            <Button Grid.Column="2" Content="Bul" Click="BtnFindCustomer_Click" MinHeight="36"/>
                            <TextBlock Grid.Column="3" Text="Ad" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="TxtCustName" Grid.Column="4"/>
                            <TextBlock Grid.Row="1" Text="Adres" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBox x:Name="TxtCustAddress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Margin="0,6,0,0">
                    <!-- Ürün görünümü -->
                    <DockPanel x:Name="ViewMenu">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="4" Margin="3,0,3,6">
                            <DockPanel>
                                <TextBlock Text="🔍" FontSize="15" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                <Button x:Name="BtnClearSearch" DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatButton}"
                                        MinHeight="30" Padding="10,2" Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                                <TextBox x:Name="TxtSearch" BorderThickness="0" TextChanged="TxtSearch_TextChanged" Margin="0" Background="Transparent"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer DockPanel.Dock="Top" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="PnlCategories"/>
                        </ScrollViewer>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <WrapPanel x:Name="PnlProducts"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Masa planı -->
                    <DockPanel x:Name="ViewTables" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource OkSoft}" BorderBrush="{StaticResource Ok}" BorderThickness="1"/>
                                <TextBlock Text="Boş" Margin="5,0,14,0" Foreground="{StaticResource TextSub}"/>
                                <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource BusySoft}" BorderBrush="{StaticResource Busy}" BorderThickness="1"/>
                                <TextBlock Text="Dolu" Margin="5,0,6,0" Foreground="{StaticResource TextSub}"/>
                            </StackPanel>
                            <WrapPanel x:Name="PnlAreas"/>
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="8" Margin="3,6,3,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Listede olmayan masa:" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" Margin="4,0"/>
                                <TextBox x:Name="TxtTable" Width="120" KeyDown="TxtTable_KeyDown"/>
                                <Button Content="Aç" Click="BtnOpenManualTable_Click" MinHeight="36"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <WrapPanel x:Name="PnlTables"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <!-- Sağ: sepet -->
            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Border x:Name="BdType" DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTypeBadge" Foreground="{StaticResource AccentDark}" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                            <TextBlock x:Name="TxtOrderTitle" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtOrderNote" FontSize="13" Foreground="{StaticResource TextSub}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <UniformGrid Columns="4">
                            <Button Content="+1" Click="BtnPlus_Click" FontWeight="Bold"/>
                            <Button Content="−1" Click="BtnMinus_Click" FontWeight="Bold"/>
                            <Button Content="Adet" Click="BtnQty_Click"/>
                            <Button Content="Sil" Style="{StaticResource DangerButton}" Click="BtnRemove_Click"/>
                        </UniformGrid>
                        <UniformGrid Columns="4">
                            <Button x:Name="BtnMoveTable" Content="Masa Taşı" Click="BtnMoveTable_Click" FontSize="13"/>
                            <Button x:Name="BtnMerge" Content="Birleştir" Click="BtnMerge_Click" FontSize="13"/>
                            <Button x:Name="BtnSplit" Content="Hesap Böl" Click="BtnSplit_Click" FontSize="13"/>
                            <Button x:Name="BtnCourier" Content="Kurye" Click="BtnCourier_Click" FontSize="13"/>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <Button Content="Ürün Notu" Click="BtnItemNote_Click"/>
                            <Button Content="Sipariş Notu" Click="BtnOrderNote_Click"/>
                            <Button Content="İndirim" Click="BtnDiscount_Click"/>
                        </UniformGrid>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="12" Padding="12,10" Margin="3,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Ara Toplam" FontSize="14" Foreground="{StaticResource TextSub}"/>
                                    <TextBlock x:Name="TxtSubtotal" FontSize="14" HorizontalAlignment="Right" Foreground="{StaticResource TextSub}"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="İndirim" FontSize="14" Foreground="{StaticResource TextSub}"/>
                                    <TextBlock x:Name="TxtDiscount" FontSize="14" HorizontalAlignment="Right" Foreground="{StaticResource TextSub}"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="TOPLAM" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock x:Name="TxtTotal" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3">
                            <Button Content="İptal" Style="{StaticResource DangerButton}" Click="BtnCancel_Click"/>
                            <Button Content="Adisyon" Click="BtnPrintBill_Click"/>
                            <Button Content="Kaydet / Mutfak" Click="BtnSave_Click"/>
                        </UniformGrid>
                        <Button Content="ÖDE" Style="{StaticResource OkButton}" FontSize="26" MinHeight="68" Click="BtnPay_Click"/>
                    </StackPanel>

                    <Grid Margin="0,10">
                        <TextBlock x:Name="TxtEmptyCart" Text="Sepet boş&#x0a;Ürün eklemek için soldaki ürünlere dokun"
                                   TextAlignment="Center" Foreground="{StaticResource TextSub}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ListBox x:Name="LstCart" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding QtyText}" FontWeight="Bold" Foreground="{StaticResource AccentDark}" FontSize="14"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource TextMain}" Margin="4,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
