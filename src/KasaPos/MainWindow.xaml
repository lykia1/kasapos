<Window x:Class="KasaPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KasaPOS" Height="768" Width="1280" MinWidth="1024" MinHeight="680"
        WindowState="Maximized" FontFamily="Segoe UI" Background="{StaticResource PanelBg}"
        Closed="Window_Closed">
    <DockPanel>
        <!-- Üst bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Dark}" Padding="10,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnMenu" Content="Menü" Style="{StaticResource TopButton}" Click="BtnMenu_Click"/>
                    <Button x:Name="BtnCustomers" Content="Müşteriler" Style="{StaticResource TopButton}" Click="BtnCustomers_Click"/>
                    <Button x:Name="BtnExpenses" Content="Giderler" Style="{StaticResource TopButton}" Click="BtnExpenses_Click"/>
                    <Button x:Name="BtnReports" Content="Raporlar" Style="{StaticResource TopButton}" Click="BtnReports_Click"/>
                    <Button x:Name="BtnSettings" Content="Ayarlar" Style="{StaticResource TopButton}" Click="BtnSettings_Click"/>
                    <Button Content="Kilitle" Style="{StaticResource TopButton}" Click="BtnLock_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBiz" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtUser" Foreground="#CBD2D9" FontSize="14" Margin="18,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDay" Foreground="#9AA5B1" FontSize="14" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: açık siparişler -->
            <DockPanel Grid.Column="0" Margin="6">
                <Button DockPanel.Dock="Top" Content="+ Yeni Sipariş" Style="{StaticResource AccentButton}" Click="BtnNew_Click" MinHeight="50"/>
                <TextBlock DockPanel.Dock="Top" Text="Açık Siparişler" FontWeight="Bold" Margin="4,10,4,4" FontSize="15"/>
                <ListBox x:Name="LstOpen" FontSize="14" SelectionChanged="LstOpen_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{StaticResource Line}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Margin="4,6" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Orta: sipariş türü + ürünler -->
            <DockPanel Grid.Column="1" Margin="6">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbGelAl" Content="Al Götür" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                        <RadioButton x:Name="RbMasa" Content="Masa" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                        <RadioButton x:Name="RbPaket" Content="Paket" GroupName="ot" Style="{StaticResource TypeToggle}" Checked="Type_Checked"/>
                    </StackPanel>

                    <StackPanel x:Name="PnlMasa" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock Text="Masa No:" FontSize="16" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox x:Name="TxtTable" Width="120" FontSize="18"/>
                    </StackPanel>

                    <Grid x:Name="PnlPaket" Visibility="Collapsed" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Telefon:" FontSize="15" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox x:Name="TxtPhone" Grid.Column="1" KeyDown="TxtPhone_KeyDown"/>
                        <Button Grid.Column="2" Content="Bul" Click="BtnFindCustomer_Click" MinHeight="34"/>
                        <TextBlock Grid.Column="3" Text="Ad:" FontSize="15" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="TxtCustName" Grid.Column="4"/>
                        <TextBlock Grid.Row="1" Text="Adres:" FontSize="15" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox x:Name="TxtCustAddress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"/>
                    </Grid>
                </StackPanel>

                <ScrollViewer DockPanel.Dock="Top" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <WrapPanel x:Name="PnlCategories"/>
                </ScrollViewer>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}" Margin="0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PnlProducts"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Sağ: sepet -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="TxtOrderTitle" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtOrderNote" FontSize="13" Foreground="#52606D" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <UniformGrid Columns="4">
                            <Button Content="+1" Click="BtnPlus_Click"/>
                            <Button Content="−1" Click="BtnMinus_Click"/>
                            <Button Content="Adet" Click="BtnQty_Click"/>
                            <Button Content="Sil" Style="{StaticResource DangerButton}" Click="BtnRemove_Click"/>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <Button Content="Ürün Notu" Click="BtnItemNote_Click"/>
                            <Button Content="Sipariş Notu" Click="BtnOrderNote_Click"/>
                            <Button Content="İndirim" Click="BtnDiscount_Click"/>
                        </UniformGrid>
                        <Border Background="{StaticResource PanelBg}" Padding="8" Margin="3,6">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Ara Toplam" FontSize="14"/>
                                    <TextBlock x:Name="TxtSubtotal" FontSize="14" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="İndirim" FontSize="14"/>
                                    <TextBlock x:Name="TxtDiscount" FontSize="14" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="TOPLAM" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtTotal" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3">
                            <Button Content="İptal" Style="{StaticResource DangerButton}" Click="BtnCancel_Click"/>
                            <Button Content="Adisyon" Click="BtnPrintBill_Click"/>
                            <Button Content="Kaydet / Mutfak" Click="BtnSave_Click"/>
                        </UniformGrid>
                        <Button Content="ÖDE" Style="{StaticResource OkButton}" FontSize="24" MinHeight="64" Click="BtnPay_Click"/>
                    </StackPanel>

                    <ListView x:Name="LstCart" Margin="0,8" FontSize="15" BorderBrush="{StaticResource Line}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4" Width="320">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding QtyText}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
