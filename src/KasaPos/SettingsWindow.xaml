<Window x:Class="KasaPos.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Width="1180" Height="760" WindowStartupLocation="CenterOwner"
        Icon="/app.ico" FontFamily="Segoe UI" Background="{StaticResource PanelBg}">
    <Window.Resources>
        <Style x:Key="HiddenTab" TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#C5CFDB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="14,11" Margin="8,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B3A4D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F76707"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="Margin" Value="4,0,4,4"/>
        </Style>
        <Style x:Key="PageHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,0,4,14"/>
        </Style>
        <Style x:Key="BigAction" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="3,6"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#1E2A3A">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,18,10,14">
                    <TextBlock Text="Ayarlar" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtNavVersion" Foreground="#8D99A6" FontSize="12"/>
                </StackPanel>
                <ListBox x:Name="LstNav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         SelectedIndex="{Binding SelectedIndex, ElementName=Tabs, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
    <DockPanel Grid.Column="1" Margin="22,18,22,14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vazgeç" Width="120" IsCancel="True"/>
            <Button Content="Kaydet" Width="160" Style="{StaticResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
        <TabControl x:Name="Tabs" FontSize="15" BorderThickness="0" Background="Transparent" Padding="0" ItemContainerStyle="{StaticResource HiddenTab}">
            <TabItem Header="İşletme">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="İşletme" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Fişte ve ekranlarda görünen işletme bilgileri, iş günü ve görünüm." Style="{StaticResource PageHint}"/>
                    <TextBlock Text="İşletme adı" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtBiz"/>
                    <TextBlock Text="Telefon" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtPhone"/>
                    <TextBlock Text="Adres" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtAddress" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    <TextBlock Text="Fiş alt yazısı" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtFooter"/>
                    <TextBlock Text="İş günü kapanış saati (bu saatten önceki satışlar bir önceki güne yazılır)" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbCutoff" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock Text="Ana ekran kutucuk rengi" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbTheme" Width="200" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="ChkCashRequired" Content="Kasa açılmadan satış yapılmasın (güne kasa açılışıyla başlanır)" Margin="3,14,3,3"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Menü ve Ürünler">
                <StackPanel Margin="4">
                    <TextBlock Text="Menü ve Ürünler" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Kategoriler, ürünler, fiyatlar, renkler ve ürün görselleri ile ürün seçenekleri (porsiyon, tercih, ücretli ekstralar)." Style="{StaticResource PageHint}"/>
                    <Button Content="Kategori ve Ürünleri Düzenle" Style="{StaticResource BigAction}" Click="OpenMenu_Click"/>
                    <Button Content="Ürün Seçenekleri ve Ekstralar" Style="{StaticResource BigAction}" Click="OpenOptions_Click"/>
                    <TextBlock Text="Toplu aktarım" FontWeight="SemiBold" FontSize="16" Margin="4,20,4,2"/>
                    <TextBlock Style="{StaticResource PageHint}" Text="Excel'de 'Kategori; Ürün; Masa Fiyatı; Gel Al Fiyatı; Paket Fiyatı; Açıklama' sütunlarıyla hazırlayıp 'CSV (noktalı virgülle ayrılmış)' olarak kaydettiğin menüyü tek seferde yükleyebilirsin. Aynı adlı ürünlerin fiyatları güncellenir."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Menüyü İçe Aktar (Excel / CSV)" Click="ImportMenu_Click" MinHeight="46"/>
                        <Button Content="Menüyü Dışa Aktar" Click="ExportMenu_Click" MinHeight="46"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Masa Düzeni">
                <StackPanel Margin="4">
                    <TextBlock Text="Masa Düzeni" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Bölümler (Salon, Bahçe, Teras…) ve masalar. Toplu masa ekleyebilirsin." Style="{StaticResource PageHint}"/>
                    <Button Content="Masaları Düzenle" Style="{StaticResource BigAction}" Click="OpenTables_Click"/>
                    <TextBlock x:Name="TxtTablesInfo" Foreground="{StaticResource TextSub}" Margin="4,8"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Stok ve Reçete">
                <StackPanel Margin="4">
                    <TextBlock Text="Stok ve Reçete" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Malzeme kartları, kritik seviyeler, maliyetler ve ürün reçeteleri. Satışlar reçeteye göre stoktan otomatik düşer." Style="{StaticResource PageHint}"/>
                    <Button Content="Stok ve Reçeteleri Düzenle" Style="{StaticResource BigAction}" Click="OpenStock_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Yazıcılar">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="Yazıcılar" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Fiş, adisyon ve mutfak çıktıları. Windows'a kurulu tüm yazıcılar listelenir." Style="{StaticResource PageHint}"/>
                    <TextBlock Text="Fiş / adisyon yazıcısı" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbReceipt"/>
                    <TextBlock Text="Mutfak yazıcısı (boş bırakılırsa fiş yazıcısı kullanılır)" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbKitchen"/>
                    <CheckBox x:Name="ChkReceiptAuto" Content="Ödeme sonrası fişi otomatik yazdır"/>
                    <CheckBox x:Name="ChkKitchenAuto" Content="Kaydet ve ödemede mutfak fişini otomatik yazdır (yalnızca yeni eklenenler)"/>
                    <CheckBox x:Name="ChkKitchenScreen" Content="Siparişleri Mutfak Ekranına da gönder (üst bardaki 'Mutfak Ekranı')"/>
                    <CheckBox x:Name="ChkCourierPrint" Content="Kurye atanınca paket fişini yazdır"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Satır genişliği (karakter)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtChars"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Kağıt genişliği (piksel)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtWidthPx"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Yazı boyutu (pt)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtFontSize"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="80 mm rulo için: 32 karakter, 280 piksel, 10 pt. 58 mm rulo için: 24 karakter, 200 piksel, 9 pt."
                               Foreground="#52606D" Margin="4,6" TextWrapping="Wrap"/>
                    <Button Content="Test fişi yazdır" HorizontalAlignment="Left" Width="180" Click="TestPrint_Click"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Kullanıcılar">
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Text="Kullanıcılar" Style="{StaticResource PageTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Text="Programı kullanan kişiler, şifreleri, yetkileri ve saatlik ücretleri." Style="{StaticResource PageHint}"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#52606D" Margin="4,0,4,6"
                               Text="Yeni kullanıcı için en alttaki boş satırı doldur. Yönetici (admin) menü, rapor ve ayarlara girebilir; kasiyer yalnızca satış ve gider girer. Şifreler en az 4 rakam ve birbirinden farklı olmalı."/>
                    <DataGrid x:Name="GridUsers" CanUserAddRows="True" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Şifre (PIN)" Binding="{Binding Pin}" Width="140"/>
                            <DataGridComboBoxColumn x:Name="ColRole" Header="Yetki" SelectedItemBinding="{Binding Role}" Width="140"/>
                            <DataGridTextColumn Header="Saatlik ücret ₺" Binding="{Binding HourlyWage, StringFormat=N2}" Width="130"/>
                            <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Active}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Kuryeler">
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Text="Kuryeler" Style="{StaticResource PageTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Text="Paket servis kuryeleri." Style="{StaticResource PageHint}"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextSub}" Margin="4,0,4,6"
                               Text="Yeni kurye için en alttaki boş satırı doldur. Çalışmayan kuryenin 'Aktif' işaretini kaldır."/>
                    <DataGrid x:Name="GridCouriers" CanUserAddRows="True" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="180"/>
                            <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Active}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Ödeme Türleri">
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Text="Ödeme Türleri" Style="{StaticResource PageTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Text="Satışta görünen ödeme seçenekleri." Style="{StaticResource PageHint}"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#52606D" Margin="4,0,4,6"
                               Text="Kullanmadığın türlerin 'Aktif' işaretini kaldır. Para üstü yalnızca 'Nakit' işaretli türlerde hesaplanır."/>
                    <DataGrid x:Name="GridPayTypes" CanUserAddRows="True" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Nakit" Binding="{Binding IsCash}" Width="70"/>
                            <DataGridTextColumn Header="Sıra" Binding="{Binding Sort}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Active}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Caller ID">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="Caller ID" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Arayan numara cihazı ile otomatik müşteri bulma." Style="{StaticResource PageHint}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSub}" Margin="4,0,4,6"
                               Text="Telefon hattına bağlı arayan numara cihazı (COM / USB-seri port üzerinden numara gönderen cihazlar ve modemler) desteklenir. Arama gelince müşteri bilgisi ekranın sağ altında açılır; 'Paket Sipariş Aç' ile doğrudan paket siparişe geçilir."/>
                    <CheckBox x:Name="ChkCid" Content="Caller ID açık"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Port" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="CmbCidPort" IsEditable="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hız (baud)" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="CmbCidBaud" IsEditable="True"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Başlatma komutu (modemler için, ör. AT+VCID=1 — cihazında gerekmiyorsa boş bırak)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtCidInit"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Test Araması Yap" Click="CidTest_Click"/>
                        <TextBlock x:Name="TxtCidStatus" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource TextSub}"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ağ / Çoklu Bilgisayar">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="Ağ / Çoklu Bilgisayar" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageHint}"
                               Text="Dükkanda birden fazla bilgisayar (ikinci kasa, mutfak ekranı, garson için Windows tablet) varsa biri 'Ana kasa' olur, veriler onda tutulur. Diğerleri aynı ağdan (Wi-Fi veya kablo) ona 'Terminal' olarak bağlanır. Yazıcılar, Caller ID ve lisans her bilgisayarda ayrıdır."/>
                    <RadioButton x:Name="RbNetSingle" Content="Tek bilgisayar (varsayılan)" GroupName="net" FontSize="15" Margin="4,6" Checked="NetMode_Checked"/>
                    <RadioButton x:Name="RbNetServer" Content="Ana kasa — diğer bilgisayarlar bu bilgisayara bağlanır" GroupName="net" FontSize="15" Margin="4,6" Checked="NetMode_Checked"/>
                    <RadioButton x:Name="RbNetClient" Content="Terminal — ağdaki ana kasaya bağlan" GroupName="net" FontSize="15" Margin="4,6" Checked="NetMode_Checked"/>

                    <Border x:Name="PnlNetServer" Style="{StaticResource Card}" Margin="3,10,3,3">
                        <StackPanel>
                            <TextBlock Text="Bu bilgisayarın adresi (terminallerde bunu yaz)" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="TxtNetIps" FontSize="22" FontWeight="Bold" FontFamily="Consolas" Margin="4,2"/>
                            <TextBlock x:Name="TxtNetStatus" Foreground="{StaticResource TextSub}" Margin="4,4"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PnlNetClient" Style="{StaticResource Card}" Margin="3,10,3,3">
                        <StackPanel>
                            <TextBlock Text="Ana kasanın adresi (ör. 192.168.1.20)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtNetHost" Width="260" HorizontalAlignment="Left"/>
                            <Button Content="Bağlantıyı Test Et" HorizontalAlignment="Left" Click="NetTest_Click"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Port" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtNetPort"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ağ şifresi (tüm bilgisayarlarda aynı)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="TxtNetKey"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Foreground="{StaticResource TextSub}" TextWrapping="Wrap" Margin="4,10"
                               Text="Not: Ana kasayı ilk açtığında Windows Güvenlik Duvarı izin sorarsa 'İzin ver' de. Ağ ayarını değiştirince program yeniden başlar."/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Yedekleme">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="Yedekleme" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Verilerin nerede tutulduğu ve yedekleri." Style="{StaticResource PageHint}"/>
                    <TextBlock TextWrapping="Wrap" Margin="4" Text="Program her açılışta günlük yedek alır ve son 30 yedeği saklar. Bilgisayar arızasına karşı yedek klasörünü düzenli olarak bir USB belleğe kopyala."/>
                    <TextBlock Text="Veri klasörü" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtDataDir" IsReadOnly="True"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Şimdi Yedekle" Click="BackupNow_Click"/>
                        <Button Content="Yedek Klasörünü Aç" Click="OpenBackups_Click"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lisans ve Güncelleme">
                <StackPanel Margin="4">
                    <TextBlock Text="Lisans ve Güncelleme" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Lisans durumu, bu bilgisayarın kodu ve program güncellemeleri." Style="{StaticResource PageHint}"/>
                    <Border Style="{StaticResource Card}" Margin="3,0,3,10">
                        <StackPanel>
                            <TextBlock x:Name="TxtLicense" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtVersion" Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Lisans Anahtarı Gir / Görüntüle" Style="{StaticResource BigAction}" Click="License_Click"/>
                    <Button Content="Güncellemeleri Denetle" Style="{StaticResource BigAction}" Click="CheckUpdate_Click"/>
                    <CheckBox x:Name="ChkAutoUpdate" Content="Açılışta yeni sürümü otomatik kontrol et" Margin="3,10,3,3"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Grid>
</Window>
