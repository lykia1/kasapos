<Window x:Class="KasaPos.CustomersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteriler" Width="900" Height="600" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Background="{StaticResource PanelBg}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Müşteriler" Style="{StaticResource H1}"/>
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Ara" Width="100" Click="Search_Click"/>
            <TextBox x:Name="TxtSearch" KeyDown="TxtSearch_KeyDown"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom">
            <Button DockPanel.Dock="Right" Content="Kapat" Width="120" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="Değişiklikleri Kaydet" Style="{StaticResource AccentButton}" Click="Save_Click"/>
            <Button DockPanel.Dock="Left" Content="Müşteriyi Sil (KVKK)" Style="{StaticResource DangerButton}" Click="Delete_Click" HorizontalAlignment="Left"/>
        </DockPanel>
        <DataGrid x:Name="GridData" CanUserAddRows="False" Margin="3,10,3,3" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="Not" Binding="{Binding Note}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
