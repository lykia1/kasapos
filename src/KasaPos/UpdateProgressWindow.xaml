<Window x:Class="KasaPos.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güncelleme" Width="460" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Topmost="True" Icon="/app.ico" FontFamily="Segoe UI" Background="White">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="Bold" Foreground="#212529"/>
        <TextBlock x:Name="TxtInfo" Text="Yeni sürüm indiriliyor, lütfen bekle…" FontSize="14" Foreground="#495057" Margin="0,6,0,12" TextWrapping="Wrap"/>
        <ProgressBar x:Name="Bar" Height="18" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="TxtPercent" FontSize="13" Foreground="#868E96" Margin="0,6,0,0" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
