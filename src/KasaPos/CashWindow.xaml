<Window x:Class="KasaPos.CashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kasa" Width="960" Height="680" WindowStartupLocation="CenterOwner"
        Icon="/app.ico" FontFamily="Segoe UI" Background="{StaticResource PanelBg}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Kasa Açılış ve Kapanış" Style="{StaticResource H1}"/>
        <Button DockPanel.Dock="Bottom" Content="Kapat" Width="120" HorizontalAlignment="Right" IsCancel="True"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: mevcut kasa -->
            <Border Style="{StaticResource Card}" Margin="3" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="TxtState" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtOpened" Foreground="{StaticResource TextSub}" Margin="0,2,0,12"/>

                    <!-- Kapalıyken -->
                    <StackPanel x:Name="PnlClosed">
                        <TextBlock Text="Açılış nakdi (kasadaki para) ₺" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtOpening" FontSize="22"/>
                        <Button Content="Kasayı Aç" Style="{StaticResource OkButton}" FontSize="18" MinHeight="54" Margin="3,12,3,3" Click="Open_Click"/>
                    </StackPanel>

                    <!-- Açıkken -->
                    <StackPanel x:Name="PnlOpen">
                        <Grid x:Name="GridSummary" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <UniformGrid Columns="2">
                            <Button Content="+ Para Ekle" Click="MoneyIn_Click"/>
                            <Button Content="− Para Çek" Click="MoneyOut_Click"/>
                        </UniformGrid>
                        <Button Content="Kasayı Kapat (Sayım)" Style="{StaticResource AccentButton}" FontSize="18" MinHeight="54" Margin="3,10,3,3" Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sağ: geçmiş -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Geçmiş kasa kapanışları" FontWeight="SemiBold" FontSize="15" Margin="4,0,4,6"/>
                    <DataGrid x:Name="GridHistory" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Açılış" Binding="{Binding OpenedText}" Width="*"/>
                            <DataGridTextColumn Header="Kapanış" Binding="{Binding ClosedText}" Width="*"/>
                            <DataGridTextColumn Header="Açılış ₺" Binding="{Binding OpeningText}" Width="90"/>
                            <DataGridTextColumn Header="Beklenen ₺" Binding="{Binding ExpectedText}" Width="95"/>
                            <DataGridTextColumn Header="Sayılan ₺" Binding="{Binding CountedText}" Width="90"/>
                            <DataGridTextColumn Header="Fark ₺" Binding="{Binding DiffText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
