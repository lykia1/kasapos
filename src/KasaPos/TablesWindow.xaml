<Window x:Class="KasaPos.TablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masa Düzeni" Width="820" Height="640" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Background="{StaticResource PanelBg}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Masa Düzeni" Style="{StaticResource H1}"/>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="3,0,3,8">
            <StackPanel>
                <TextBlock Text="Toplu masa ekle" FontWeight="SemiBold" FontSize="15" Margin="4,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Bölüm (ör. Salon, Bahçe, Teras)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtArea" Text="Salon"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Ön ek (ör. B)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtPrefix"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Başlangıç no" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtStart" Text="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Masa sayısı" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtCount" Text="10"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="Ekle" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Width="100" Click="Bulk_Click"/>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextSub}" Margin="4,0,4,6"
                   Text="Masaları tabloda düzenleyebilir, tek masa için en alttaki boş satırı kullanabilirsin. Kullanılmayan masanın 'Aktif' işaretini kaldır. Masa adları birbirinden farklı olmalı."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Kapat" Width="120" IsCancel="True"/>
            <Button Content="Kaydet" Width="160" Style="{StaticResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
        <DataGrid x:Name="GridTables" CanUserAddRows="True" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bölüm" Binding="{Binding Area}" Width="*"/>
                <DataGridTextColumn Header="Masa adı" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Sıra" Binding="{Binding Sort}" Width="80"/>
                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Active}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
