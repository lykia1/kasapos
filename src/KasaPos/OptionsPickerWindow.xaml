<Window x:Class="KasaPos.OptionsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün Seçenekleri" Width="760" Height="620" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Background="{StaticResource PanelBg}">
    <Window.Resources>
        <Style x:Key="OptToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="#CED4DA" BorderThickness="2" CornerRadius="10" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F76707"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D9480F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E2A3A" Padding="16,12">
            <DockPanel>
                <TextBlock x:Name="TxtPrice" DockPanel.Dock="Right" Foreground="#FFD43B" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtProduct" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="12">
            <TextBlock x:Name="TxtError" Foreground="{StaticResource Danger}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vazgeç" Width="130" IsCancel="True" MinHeight="54"/>
                <Button Content="Ekle" Width="200" Style="{StaticResource OkButton}" FontSize="20" MinHeight="54" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,8,12,0">
            <StackPanel x:Name="PnlGroups"/>
        </ScrollViewer>
    </DockPanel>
</Window>
