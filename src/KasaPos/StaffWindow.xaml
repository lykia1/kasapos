<Window x:Class="KasaPos.StaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel" Width="1000" Height="660" WindowStartupLocation="CenterOwner"
        Icon="/app.ico" FontFamily="Segoe UI" Background="{StaticResource PanelBg}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Personel Giriş-Çıkış" Style="{StaticResource H1}"/>
        <Button DockPanel.Dock="Bottom" Content="Kapat" Width="120" HorizontalAlignment="Right" IsCancel="True"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Mesaiye başlayan veya çıkan, adına dokunup şifresini girer." TextWrapping="Wrap"
                               Foreground="{StaticResource TextSub}" Margin="4,0,4,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PnlStaff"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border x:Name="PnlReport" Grid.Column="1" Style="{StaticResource Card}" Margin="3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Mesai raporu (yönetici)" FontWeight="SemiBold" FontSize="15" Margin="4,0,4,6"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <DatePicker x:Name="DpFrom" Width="140" Margin="3"/>
                        <DatePicker x:Name="DpTo" Width="140" Margin="3"/>
                        <Button Content="Göster" Click="Report_Click"/>
                        <Button Content="Bu ay" Click="ThisMonth_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Saatlik ücreti Ayarlar > Kullanıcılar'dan girebilirsin." Foreground="{StaticResource TextSub}" Margin="4,6"/>
                    <DataGrid x:Name="GridTotals" IsReadOnly="True" Margin="3,8,3,3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Personel" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Gün" Binding="{Binding Days}" Width="60"/>
                            <DataGridTextColumn Header="Toplam süre" Binding="{Binding HoursText}" Width="120"/>
                            <DataGridTextColumn Header="Saatlik ₺" Binding="{Binding WageText}" Width="90"/>
                            <DataGridTextColumn Header="Hakediş" Binding="{Binding PayText}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
